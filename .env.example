# Required: Alibaba Cloud DashScope API key
DASHSCOPE_API_KEY=your_dashscope_api_key

# Model configuration. Change these when a model quota is exhausted.
# Visual table OCR and visual arbitration.
VLM_MODEL=qwen-vl-plus
# Route B/B2 text extraction and unknown metric analysis.
TEXT_MODEL=qwen-plus-2025-09-11
# Lightweight schema judge for mapping table rows to ESG fields.
SCHEMA_JUDGE_MODEL=qwen3.6-flash
SEMANTIC_JUDGE_ENABLED=true
# Fallback schema judge for low-confidence cases.
SCHEMA_JUDGE_FALLBACK_ENABLED=true
SCHEMA_JUDGE_FALLBACK_MODEL=qwen3.6-plus
# RAG embedding. "local" does not call external embedding APIs; "dashscope" uses RAG_EMBEDDING_MODEL.
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL=text-embedding-v4

# PDF parser: auto / mineru / pymupdf
PDF_PARSER_BACKEND=auto

# Keep false if MinerU is not installed. The system can use existing MinerU artifacts or fall back to PyMuPDF.
MINERU_AUTO_RUN_ENABLED=false
MINERU_COMMAND=
MINERU_OUTPUT_ROOT=output/mineru_test
MINERU_FALLBACK_TO_PYMUPDF=true

# Runtime limits and feature switches.
LLM_MATCHER_ENABLED=true
MAX_LLM_CALLS_PER_REPORT=30
MAX_B2_LLM_CALLS_PER_REPORT=40
UNIFIED_PARALLEL_ROUTES=false
